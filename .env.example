# === Required for any run ===
# At least one provider key. The gateway boots with whichever key(s)
# you supply; uncomment additional providers as needed.
GATEWAY_PROVIDERS__OPENAI__API_KEY=sk-your-openai-key
# GATEWAY_PROVIDERS__ANTHROPIC__API_KEY=sk-ant-...
# GATEWAY_PROVIDERS__GOOGLE__API_KEY=...

# === Auth (compose stack defaults auth.enabled = true) ===
# Static bearer token for /internal/admin/* endpoints. The compose
# stack pre-sets this to "dev-admin-token" in docker-compose.yml;
# override here only if you need a different value.
# GATEWAY_AUTH__ADMIN_TOKEN=dev-admin-token

# === Optional config overrides ===
# Env vars use double underscore (__) as the hierarchy separator.
# GATEWAY_SERVER__PORT=8080
# GATEWAY_SERVER__READ_TIMEOUT=30s
# GATEWAY_SERVER__WRITE_TIMEOUT=120s
# GATEWAY_PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1
# GATEWAY_PROVIDERS__OPENAI__TIMEOUT=30s
# GATEWAY_LOG__LEVEL=debug
# GATEWAY_LOG__FORMAT=json
# GATEWAY_LOG__DEBUG_BODIES=false
# GATEWAY_CONFIG_PATH=configs/gateway.yaml
